# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API Keys.
# .env.local is git-ignored, so real values never reach GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret for AI captions (note: NO "NEXT_PUBLIC_" prefix, so it
# never reaches the browser). Set ONE of these. Get a key from
# https://aistudio.google.com/apikey or https://console.groq.com
GEMINI_API_KEY=your-gemini-api-key
# GROQ_API_KEY=your-groq-api-key
